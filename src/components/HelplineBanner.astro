---
interface Props {
    helplineLabel?: string;
    freeLabel?: string;
    changeCountryLabel?: string;
}

const {
    helplineLabel = "Телефон доверия",
    freeLabel = "бесплатно",
    changeCountryLabel = "Сменить страну",
} = Astro.props;
---

<aside
    class="helpline-banner"
    id="helpline-banner"
    aria-label={helplineLabel}
    data-free-label={freeLabel}
    data-change-country-label={changeCountryLabel}
>
    <div class="container helpline-banner-container">
        <div class="helpline-banner-left">
            <div class="helpline-status-pulse" aria-hidden="true"></div>
            <div class="helpline-banner-info">
                <span class="helpline-banner-label" data-i18n="common.helpline"
                    >{helplineLabel}</span
                >
                <span
                    class="badge badge-success helpline-banner-badge"
                    id="helpline-badge">{freeLabel}</span
                >
            </div>
        </div>

        <div class="helpline-banner-right">
            <a
                href="tel:88002000122"
                class="btn btn-primary btn-sm helpline-banner-phone"
                id="helpline-phone"
            >
                <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                    ></path>
                </svg>
                <span id="helpline-phone-text">8-800-2000-122</span>
            </a>

            <button
                class="btn btn-ghost btn-sm helpline-banner-change"
                id="helpline-change"
                type="button"
                aria-label={changeCountryLabel}
                title={changeCountryLabel}
            >
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path
                        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                    ></path>
                </svg>
                <span
                    class="helpline-change-text"
                    data-i18n="common.changeCountry">{changeCountryLabel}</span
                >
            </button>
        </div>
    </div>
</aside>

<style>
    .helpline-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 40;
        background: rgba(17, 23, 38, 0.95);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-top: 1px solid var(--border-medium);
        padding: 0.75rem 0;
        box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.5);
    }

    .helpline-banner-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .helpline-banner-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .helpline-status-pulse {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 8px var(--success);
        flex-shrink: 0;
    }

    .helpline-banner-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .helpline-banner-label {
        font-family: var(--font-display);
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--text-primary);
        white-space: nowrap;
    }

    .helpline-banner-badge {
        display: none;
    }

    @media (min-width: 480px) {
        .helpline-banner-badge {
            display: inline-flex;
        }
    }

    .helpline-banner-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .helpline-banner-phone {
        font-size: 0.875rem;
        font-weight: 700;
    }

    .helpline-banner-change {
        padding: 0.5rem 0.75rem;
    }

    .helpline-change-text {
        display: none;
    }

    @media (min-width: 640px) {
        .helpline-change-text {
            display: inline;
        }
    }
</style>

<script>
    import helplines from "../data/helplines.json";

    type CountryCode = keyof typeof helplines;

    interface HelplineData {
        primary: {
            phone: string;
            free: boolean;
        };
    }

    function formatPhoneForTel(phone: string): string {
        return phone.replace(/[^\d+]/g, "");
    }

    function updateBanner(countryCode: CountryCode) {
        const banner = document.getElementById("helpline-banner");
        const phoneLink = document.getElementById("helpline-phone");
        const phoneText = document.getElementById("helpline-phone-text");
        const badge = document.getElementById("helpline-badge");

        if (!banner || !phoneLink || !phoneText || !badge) return;

        const country = (helplines as Record<string, HelplineData>)[
            countryCode
        ];
        if (!country?.primary) return;

        const { phone, free } = country.primary;

        phoneText.textContent = phone;
        phoneLink.setAttribute("href", `tel:${formatPhoneForTel(phone)}`);

        const freeLabel = banner.getAttribute("data-free-label") || "бесплатно";
        badge.textContent = free ? freeLabel : "";
        badge.style.display = free ? "inline-flex" : "none";

        localStorage.setItem("userCountry", countryCode);
    }

    async function detectCountry(): Promise<CountryCode> {
        const saved = localStorage.getItem("userCountry");
        if (saved && saved in helplines) {
            return saved as CountryCode;
        }

        try {
            const response = await fetch(
                "https://ip-api.com/json/?fields=countryCode",
                {
                    signal: AbortSignal.timeout(3000),
                },
            );
            const data = await response.json();
            if (data.countryCode && data.countryCode in helplines) {
                return data.countryCode as CountryCode;
            }
        } catch {}

        return "RU";
    }

    function scrollToResources() {
        const resourcesSection = document.getElementById("resources");
        if (resourcesSection) {
            resourcesSection.scrollIntoView({ behavior: "smooth" });
        } else {
            window.location.href = "/#resources";
        }
    }

    async function initHelplineBanner() {
        const country = await detectCountry();
        updateBanner(country);

        const changeButton = document.getElementById("helpline-change");
        if (changeButton) {
            changeButton.addEventListener("click", scrollToResources);
        }

        window.addEventListener("countryChanged", ((
            event: CustomEvent<{ country: CountryCode }>,
        ) => {
            updateBanner(event.detail.country);
        }) as EventListener);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHelplineBanner);
    } else {
        initHelplineBanner();
    }
</script>
