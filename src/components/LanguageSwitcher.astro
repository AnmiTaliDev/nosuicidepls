---
import { locales } from "../i18n/config";
---

<div class="lang-switcher" role="navigation" aria-label="Language selection">
    {
        Object.values(locales).map((locale) => (
            <button
                class="lang-btn"
                data-lang-btn={locale.code}
                aria-label={locale.name}
                type="button"
            >
                {locale.code.toUpperCase()}
            </button>
        ))
    }
</div>

<style>
    .lang-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .lang-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-muted);
        font-size: var(--font-micro);
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        border-radius: var(--radius-btn);
    }

    .lang-btn:hover {
        color: var(--text-primary);
    }

    .lang-btn.active {
        color: var(--text-primary);
        border-color: var(--border);
        background: var(--surface-1);
    }
</style>

<script>
    function initLangSwitcher() {
        const buttons =
            document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
        const saved = localStorage.getItem("locale") || "ru";

        buttons.forEach((btn) => {
            if (btn.dataset.langBtn === saved) btn.classList.add("active");

            btn.addEventListener("click", () => {
                const locale = btn.dataset.langBtn!;
                localStorage.setItem("locale", locale);
                buttons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                document.dispatchEvent(
                    new CustomEvent("localeChanged", { detail: { locale } }),
                );
            });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLangSwitcher);
    } else {
        initLangSwitcher();
    }
</script>
