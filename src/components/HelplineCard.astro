---
interface HelplineLine {
    phone: string;
    name: string;
    nameEn?: string;
    nameKk?: string;
    description?: string;
    descEn?: string;
    descKk?: string;
    hours?: string;
}

interface Props {
    countryName: string;
    countryNameEn?: string;
    countryNameKk?: string;
    lines: HelplineLine[];
}

const { countryName, countryNameEn, countryNameKk, lines } = Astro.props;

function formatPhoneForTel(phone: string): string {
    return phone.replace(/[^\d+]/g, "");
}
---

<div class="helpline-group">
    <h3
        class="country-title"
        data-name-ru={countryName}
        data-name-en={countryNameEn || countryName}
        data-name-kk={countryNameKk || countryName}
    >
        {countryName}
    </h3>

    <div class="lines-list">
        {
            lines.map((line) => (
                <div class="line-row">
                    <div class="line-meta">
                        <div
                            class="line-name"
                            data-name-ru={line.name}
                            data-name-en={line.nameEn || line.name}
                            data-name-kk={line.nameKk || line.name}
                        >
                            {line.name}
                        </div>
                        {(line.description || line.hours) && (
                            <div class="line-sub">
                                {line.description && (
                                    <span
                                        data-name-ru={line.description}
                                        data-name-en={
                                            line.descEn || line.description
                                        }
                                        data-name-kk={
                                            line.descKk || line.description
                                        }
                                    >
                                        {line.description}
                                    </span>
                                )}
                                {line.description && line.hours && (
                                    <span> &middot; </span>
                                )}
                                {line.hours && (
                                    <span data-i18n-hours={line.hours}>
                                        {line.hours}
                                    </span>
                                )}
                            </div>
                        )}
                    </div>

                    <a
                        href={`tel:${formatPhoneForTel(line.phone)}`}
                        class="line-phone"
                    >
                        {line.phone}
                    </a>
                </div>
            ))
        }
    </div>
</div>

<style>
    .helpline-group {
        padding: 2.5rem 0;
        border-bottom: 1px solid var(--border);
    }

    .helpline-group:last-child {
        border-bottom: none;
    }

    .country-title {
        font-size: 1.15rem;
        font-weight: 500;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .lines-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .line-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    @media (max-width: 540px) {
        .line-row {
            flex-direction: column;
            gap: 0.35rem;
        }
    }

    .line-meta {
        display: flex;
        flex-direction: column;
    }

    .line-name {
        font-size: var(--font-body);
        color: var(--text-primary);
    }

    .line-sub {
        font-size: var(--font-micro);
        color: var(--text-muted);
    }

    .line-phone {
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-primary);
        text-decoration: none;
        white-space: nowrap;
    }

    .line-phone:hover {
        color: var(--accent);
        text-decoration: underline;
    }
</style>
