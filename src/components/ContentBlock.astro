---
interface Props {
    text: string;
    highlight?: boolean;
    i18nKey?: string;
}

const { text, highlight = false, i18nKey } = Astro.props;
---

<div class:list={["statement", { "statement-accent": highlight }]}>
    <p data-i18n={i18nKey}>{text}</p>
</div>

<style>
    .statement {
        padding: 2rem 0;
        border-bottom: 1px solid var(--border);
    }

    .statement:last-child {
        border-bottom: none;
    }

    .statement p {
        font-size: var(--font-body);
        line-height: 1.5;
        color: var(--text-muted);
        margin: 0;
    }

    .statement-accent p {
        color: var(--text-primary);
        font-weight: 500;
    }
</style>
