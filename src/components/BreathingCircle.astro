---
interface Props {
    breatheInText?: string;
    breatheOutText?: string;
}

const { breatheInText = "Вдох", breatheOutText = "Выдох" } = Astro.props;
---

<div class="breathing-widget" aria-live="polite" aria-atomic="true">
    <p
        class="breathing-text"
        data-breathe-in={breatheInText}
        data-breathe-out={breatheOutText}
    >
        {breatheInText}
    </p>
</div>

<style>
    .breathing-widget {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem 0;
    }

    .breathing-text {
        font-size: 1.1rem;
        color: var(--text-muted);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin: 0;
    }
</style>

<script>
    function initBreathingAnimation() {
        const textElement = document.querySelector(".breathing-text");
        if (!textElement) return;

        const breatheIn = textElement.getAttribute("data-breathe-in") || "Вдох";
        const breatheOut =
            textElement.getAttribute("data-breathe-out") || "Выдох";

        let isInhaling = true;

        setInterval(() => {
            textElement.textContent = isInhaling ? breatheOut : breatheIn;
            isInhaling = !isInhaling;
        }, 4000);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBreathingAnimation);
    } else {
        initBreathingAnimation();
    }
</script>
