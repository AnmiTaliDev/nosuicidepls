---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ruTranslations from "../i18n/ru.json";
import enTranslations from "../i18n/en.json";
import kkTranslations from "../i18n/kk.json";

interface Props {
    title: string;
    description: string;
    keywords?: string;
}

const { title, description, keywords } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://nosuicidepls.org",
);
const ogImageURL = new URL(
    "/og-image.png",
    Astro.site || "https://nosuicidepls.org",
);
const allTranslations = {
    ru: ruTranslations,
    en: enTranslations,
    kk: kkTranslations,
};
---

<!doctype html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />

        <title>{title}</title>
        <meta name="description" content={description} />
        {keywords && <meta name="keywords" content={keywords} />}

        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:site_name" content="Ты нужен. Останься." />
        <meta property="og:locale" content="ru_RU" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <meta name="referrer" content="no-referrer" />
        <meta name="robots" content="index, follow" />
        <meta name="author" content="AnmiTaliDev" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta name="theme-color" content="#231d19" />
    </head>
    <body>
        <a href="#main-content" class="skip-link">Перейти к содержимому</a>

        <div class="lang-fixed">
            <LanguageSwitcher />
        </div>

        <main id="main-content">
            <slot />
        </main>

        <footer class="footer">
            <div class="container footer-inner">
                <nav class="footer-nav" aria-label="Навигация">
                    <a
                        href="/"
                        class:list={[{ active: currentPath === "/" }]}
                        data-i18n="pause.title"
                    >
                        {ruTranslations.pause.title}
                    </a>
                    <a
                        href="/seems"
                        class:list={[{ active: currentPath === "/seems" }]}
                        data-i18n="resources.seemsLikeLink"
                    >
                        {
                            ruTranslations.resources.seemsLikeLink.replace(
                                " →",
                                "",
                            )
                        }
                    </a>
                    <a
                        href="/help-someone"
                        class:list={[
                            { active: currentPath === "/help-someone" },
                        ]}
                        data-i18n="resources.helpOthers"
                    >
                        {ruTranslations.resources.helpOthers}
                    </a>
                </nav>
                <div class="footer-meta">
                    <span>
                        <span data-i18n="footer.developer"
                            >{ruTranslations.footer.developer}</span
                        >:
                        <a
                            href="https://github.com/AnmiTaliDev"
                            target="_blank"
                            rel="noopener noreferrer">AnmiTaliDev</a
                        >
                    </span>
                    <span>&middot;</span>
                    <span>
                        <span data-i18n="footer.ideaAuthor"
                            >{ruTranslations.footer.ideaAuthor}</span
                        >: GLOR
                    </span>
                    <span>&middot;</span>
                    <a
                        href="https://github.com/AnmiTaliDev/nosuicidepls"
                        target="_blank"
                        rel="noopener noreferrer"
                        data-i18n="footer.source"
                    >
                        {ruTranslations.footer.source}
                    </a>
                </div>
            </div>
        </footer>

        <script
            id="__i18n_data"
            type="application/json"
            set:html={JSON.stringify(allTranslations)}
        />

        <script>
            (function () {
                const dataEl = document.getElementById("__i18n_data");
                if (!dataEl) return;
                const allTranslations = JSON.parse(dataEl.textContent || "{}");

                function getVal(
                    obj: Record<string, unknown>,
                    key: string,
                ): string | undefined {
                    const result = key.split(".").reduce<unknown>((o, k) => {
                        if (o && typeof o === "object")
                            return (o as Record<string, unknown>)[k];
                        return undefined;
                    }, obj);
                    return typeof result === "string" ? result : undefined;
                }

                function applyLocale(locale: string) {
                    const t = allTranslations[locale] || allTranslations["ru"];
                    if (!t) return;

                    document
                        .querySelectorAll<HTMLElement>("[data-i18n]")
                        .forEach((el) => {
                            const val = getVal(t, el.dataset.i18n!);
                            if (val !== undefined) el.textContent = val;
                        });

                    document
                        .querySelectorAll<HTMLElement>("[data-i18n-aria]")
                        .forEach((el) => {
                            const val = getVal(t, el.dataset.i18nAria!);
                            if (val !== undefined)
                                el.setAttribute("aria-label", val);
                        });

                    const nameKey = `data-name-${locale}`;
                    document
                        .querySelectorAll<HTMLElement>(`[${nameKey}]`)
                        .forEach((el) => {
                            const val = el.getAttribute(nameKey);
                            if (val) el.textContent = val;
                        });

                    const hoursMap = (t as Record<string, any>).common
                        ?.hoursMap as Record<string, string> | undefined;
                    if (hoursMap) {
                        document
                            .querySelectorAll<HTMLElement>("[data-i18n-hours]")
                            .forEach((el) => {
                                const ruHours = el.dataset.i18nHours!;
                                el.textContent = hoursMap[ruHours] ?? ruHours;
                            });
                    }

                    document.documentElement.lang = locale;
                    const titleVal = getVal(t, "meta.title");
                    if (titleVal) document.title = titleVal;
                    const descMeta = document.querySelector<HTMLMetaElement>(
                        'meta[name="description"]',
                    );
                    const descVal = getVal(t, "meta.description");
                    if (descMeta && descVal) descMeta.content = descVal;

                    document
                        .querySelectorAll<HTMLButtonElement>("[data-lang-btn]")
                        .forEach((btn) => {
                            btn.classList.toggle(
                                "active",
                                btn.dataset.langBtn === locale,
                            );
                        });
                }

                function detectLocale(): string {
                    const saved = localStorage.getItem("locale");
                    if (
                        saved &&
                        (saved === "ru" || saved === "en" || saved === "kk")
                    ) {
                        return saved;
                    }

                    const navLangs = navigator.languages || [
                        navigator.language || "",
                    ];
                    for (const lang of navLangs) {
                        const code = lang.toLowerCase();
                        if (code.startsWith("kk") || code.startsWith("kz"))
                            return "kk";
                        if (
                            code.startsWith("ru") ||
                            code.startsWith("be") ||
                            code.startsWith("uk")
                        )
                            return "ru";
                        if (code.startsWith("en")) return "en";
                    }

                    return "ru";
                }

                const initialLocale = detectLocale();
                applyLocale(initialLocale);

                document.addEventListener("localeChanged", (e: Event) => {
                    applyLocale(
                        (e as CustomEvent<{ locale: string }>).detail.locale,
                    );
                });
            })();
        </script>
    </body>
</html>

<style>
    .lang-fixed {
        position: absolute;
        top: 2rem;
        right: 2rem;
        z-index: 10;
    }

    .footer {
        margin-top: auto;
        border-top: 1px solid var(--border);
        padding: 4rem 0;
    }

    .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .footer-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .footer-nav a {
        font-size: 0.95rem;
        color: var(--text-muted);
        text-decoration: none;
    }

    .footer-nav a:hover,
    .footer-nav a.active {
        color: var(--text-primary);
    }

    .footer-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: var(--font-micro);
        color: var(--text-muted);
    }

    .footer-meta a {
        color: var(--text-muted);
    }

    .footer-meta a:hover {
        color: var(--text-primary);
    }
</style>
