---
import Layout from "../layouts/Layout.astro";
import { getTranslations } from "../i18n/utils";
import helplines from "../data/helplines.json";

const t = getTranslations();
const s = t.seemsLike;

const featuredCountries = ["RU", "KZ", "UA"] as const;
const featuredLines = featuredCountries
    .map((code) => (helplines as Record<string, typeof helplines.RU>)[code])
    .filter(Boolean);
---

<Layout title={s.meta.title} description={s.meta.description}>
    <div class="container page-container">
        <header class="page-header">
            <a href="/" class="back-link" data-i18n="seemsLike.hero.back"
                >{s.hero.back}</a
            >
            <h1 class="page-title" data-i18n="seemsLike.hero.title">
                {s.hero.title}
            </h1>
            <p class="page-subtitle" data-i18n="seemsLike.hero.subtitle">
                {s.hero.subtitle}
            </p>
        </header>

        <div class="intro-block">
            <p data-i18n="seemsLike.intro">{s.intro}</p>
        </div>

        <div class="distortions-list">
            <article class="distortion-item">
                <h2 class="distortion-title" data-i18n="seemsLike.d1.thought">
                    {s.d1.thought}
                </h2>
                <div class="distortion-body">
                    <p
                        class="distortion-validation"
                        data-i18n="seemsLike.d1.validation"
                    >
                        {s.d1.validation}
                    </p>
                    <div class="distortion-reframe">
                        <span class="label" data-i18n="seemsLike.reframeLabel"
                            >{s.reframeLabel}:</span
                        >
                        <p data-i18n="seemsLike.d1.reframe">{s.d1.reframe}</p>
                    </div>
                    <div class="distortion-try">
                        <span class="label" data-i18n="seemsLike.tryLabel"
                            >{s.tryLabel}:</span
                        >
                        <p data-i18n="seemsLike.d1.try">{s.d1.try}</p>
                    </div>
                </div>
            </article>

            <article class="distortion-item">
                <h2 class="distortion-title" data-i18n="seemsLike.d2.thought">
                    {s.d2.thought}
                </h2>
                <div class="distortion-body">
                    <p
                        class="distortion-validation"
                        data-i18n="seemsLike.d2.validation"
                    >
                        {s.d2.validation}
                    </p>
                    <div class="distortion-reframe">
                        <span class="label" data-i18n="seemsLike.reframeLabel"
                            >{s.reframeLabel}:</span
                        >
                        <p data-i18n="seemsLike.d2.reframe">{s.d2.reframe}</p>
                    </div>
                    <div class="distortion-try">
                        <span class="label" data-i18n="seemsLike.tryLabel"
                            >{s.tryLabel}:</span
                        >
                        <p data-i18n="seemsLike.d2.try">{s.d2.try}</p>
                    </div>
                </div>
            </article>

            <article class="distortion-item">
                <h2 class="distortion-title" data-i18n="seemsLike.d3.thought">
                    {s.d3.thought}
                </h2>
                <div class="distortion-body">
                    <p
                        class="distortion-validation"
                        data-i18n="seemsLike.d3.validation"
                    >
                        {s.d3.validation}
                    </p>
                    <div class="distortion-reframe">
                        <span class="label" data-i18n="seemsLike.reframeLabel"
                            >{s.reframeLabel}:</span
                        >
                        <p data-i18n="seemsLike.d3.reframe">{s.d3.reframe}</p>
                    </div>
                    <div class="distortion-try">
                        <span class="label" data-i18n="seemsLike.tryLabel"
                            >{s.tryLabel}:</span
                        >
                        <p data-i18n="seemsLike.d3.try">{s.d3.try}</p>
                    </div>
                </div>
            </article>

            <article class="distortion-item">
                <h2 class="distortion-title" data-i18n="seemsLike.d4.thought">
                    {s.d4.thought}
                </h2>
                <div class="distortion-body">
                    <p
                        class="distortion-validation"
                        data-i18n="seemsLike.d4.validation"
                    >
                        {s.d4.validation}
                    </p>
                    <div class="distortion-reframe">
                        <span class="label" data-i18n="seemsLike.reframeLabel"
                            >{s.reframeLabel}:</span
                        >
                        <p data-i18n="seemsLike.d4.reframe">{s.d4.reframe}</p>
                    </div>
                    <div class="distortion-try">
                        <span class="label" data-i18n="seemsLike.tryLabel"
                            >{s.tryLabel}:</span
                        >
                        <p data-i18n="seemsLike.d4.try">{s.d4.try}</p>
                    </div>
                </div>
            </article>

            <article class="distortion-item">
                <h2 class="distortion-title" data-i18n="seemsLike.d5.thought">
                    {s.d5.thought}
                </h2>
                <div class="distortion-body">
                    <p
                        class="distortion-validation"
                        data-i18n="seemsLike.d5.validation"
                    >
                        {s.d5.validation}
                    </p>
                    <div class="distortion-reframe">
                        <span class="label" data-i18n="seemsLike.reframeLabel"
                            >{s.reframeLabel}:</span
                        >
                        <p data-i18n="seemsLike.d5.reframe">{s.d5.reframe}</p>
                    </div>
                    <div class="distortion-try">
                        <span class="label" data-i18n="seemsLike.tryLabel"
                            >{s.tryLabel}:</span
                        >
                        <p data-i18n="seemsLike.d5.try">{s.d5.try}</p>
                    </div>
                </div>
            </article>

            <article class="distortion-item">
                <h2 class="distortion-title" data-i18n="seemsLike.d6.thought">
                    {s.d6.thought}
                </h2>
                <div class="distortion-body">
                    <p
                        class="distortion-validation"
                        data-i18n="seemsLike.d6.validation"
                    >
                        {s.d6.validation}
                    </p>
                    <div class="distortion-reframe">
                        <span class="label" data-i18n="seemsLike.reframeLabel"
                            >{s.reframeLabel}:</span
                        >
                        <p data-i18n="seemsLike.d6.reframe">{s.d6.reframe}</p>
                    </div>
                    <div class="distortion-try">
                        <span class="label" data-i18n="seemsLike.tryLabel"
                            >{s.tryLabel}:</span
                        >
                        <p data-i18n="seemsLike.d6.try">{s.d6.try}</p>
                    </div>
                </div>
            </article>
        </div>

        <div class="conclusion-block">
            <p class="conclusion-text" data-i18n="seemsLike.close.text">
                {s.close.text}
            </p>
            <a
                href="/#resources"
                class="btn btn-accent"
                data-i18n="seemsLike.close.button"
            >
                {s.close.button}
            </a>
        </div>

        <div class="hotlines-block">
            <h2 data-i18n="seemsLike.hotlines.title">{s.hotlines.title}</h2>
            <p data-i18n="seemsLike.hotlines.text">{s.hotlines.text}</p>
            <div class="hotlines-simple">
                {
                    featuredLines.map((country) => (
                        <div class="hotline-simple-row">
                            <span
                                data-name-ru={country.name}
                                data-name-en={
                                    (country as any).nameEn || country.name
                                }
                                data-name-kk={
                                    (country as any).nameKk || country.name
                                }
                            >
                                {country.name}:
                            </span>
                            {country.lines.slice(0, 1).map((line) => (
                                <a
                                    href={`tel:${line.phone.replace(/[^\d+]/g, "")}`}
                                    class="phone-link"
                                >
                                    {line.phone}
                                </a>
                            ))}
                        </div>
                    ))
                }
            </div>
            <div class="all-link-wrap">
                <a href="/#resources" data-i18n="seemsLike.hotlines.link">
                    {s.hotlines.link}
                </a>
            </div>
        </div>
    </div>
</Layout>

<style>
    .page-container {
        padding: 6rem 1.5rem 8rem;
    }

    .page-header {
        margin-bottom: 3.5rem;
    }

    .back-link {
        display: inline-block;
        font-size: var(--font-micro);
        color: var(--text-muted);
        margin-bottom: 2rem;
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--text-primary);
    }

    .page-title {
        margin-bottom: 1rem;
    }

    .page-subtitle {
        font-size: 1.15rem;
        line-height: 1.5;
        margin: 0;
    }

    .intro-block {
        padding: 2rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 4rem;
    }

    .distortions-list {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
        margin-bottom: 5rem;
    }

    .distortion-item {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding-bottom: 3.5rem;
        border-bottom: 1px solid var(--border);
    }

    .distortion-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .distortion-title {
        font-size: 1.4rem;
        color: var(--text-primary);
    }

    .distortion-body {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .distortion-validation {
        color: var(--text-primary);
        margin: 0;
    }

    .distortion-reframe,
    .distortion-try {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .label {
        font-size: var(--font-micro);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        font-weight: 500;
    }

    .distortion-reframe p,
    .distortion-try p {
        color: var(--text-muted);
        margin: 0;
    }

    .conclusion-block {
        padding: 3.5rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 4rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.75rem;
    }

    .conclusion-text {
        font-size: 1.25rem;
        color: var(--text-primary);
        margin: 0;
    }

    .hotlines-block h2 {
        margin-bottom: 0.75rem;
    }

    .hotlines-simple {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 1.5rem 0;
    }

    .hotline-simple-row {
        display: flex;
        gap: 0.5rem;
        font-size: 1rem;
    }

    .hotline-simple-row span {
        color: var(--text-muted);
    }

    .phone-link {
        color: var(--text-primary);
        font-weight: 500;
    }

    .all-link-wrap {
        margin-top: 1.5rem;
    }
</style>
