---
import Layout from "../layouts/Layout.astro";
import HelplineCard from "../components/HelplineCard.astro";
import ContentBlock from "../components/ContentBlock.astro";
import { getTranslations } from "../i18n/utils";
import helplines from "../data/helplines.json";

const t = getTranslations();
const allCountries = Object.entries(helplines).map(([code, data]) => ({
    code,
    ...data,
}));
---

<Layout
    title={t.meta.title}
    description={t.meta.description}
    keywords={t.meta.keywords}
>
    <section class="grounding-screen" aria-label="Экран заземления и помощи">
        <div class="container grounding-content">
            <div class="grounding-head">
                <h1 class="grounding-title" data-i18n="pause.title">
                    {t.pause.title}
                </h1>
                <p class="grounding-text" data-i18n="pause.subtitle">
                    {t.pause.subtitle}
                </p>
            </div>

            <div class="all-hotlines-direct" id="hotlines-list">
                {
                    allCountries.map((c) => {
                        const primaryLine = (c as any).primary || c.lines[0];
                        return (
                            <div class="direct-row" data-country-code={c.code}>
                                <span
                                    class="direct-country"
                                    data-name-ru={c.name}
                                    data-name-en={(c as any).nameEn || c.name}
                                    data-name-kk={(c as any).nameKk || c.name}
                                >
                                    {c.name}
                                </span>
                                <a
                                    href={`tel:${primaryLine.phone.replace(/[^\d+]/g, "")}`}
                                    class="direct-phone"
                                >
                                    {primaryLine.phone}
                                </a>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <section id="content" class="content-section" aria-label="Текст поддержки">
        <div class="container">
            <div class="statements-list">
                <ContentBlock
                    text={t.content.search}
                    highlight={true}
                    i18nKey="content.search"
                />
                <ContentBlock
                    text={t.content.block1}
                    i18nKey="content.block1"
                />
                <ContentBlock
                    text={t.content.block2}
                    i18nKey="content.block2"
                />
                <ContentBlock
                    text={t.content.block3}
                    i18nKey="content.block3"
                />
                <ContentBlock
                    text={t.content.block4}
                    i18nKey="content.block4"
                />
                <ContentBlock
                    text={t.content.block5}
                    i18nKey="content.block5"
                />
                <ContentBlock
                    text={t.content.block6}
                    highlight={true}
                    i18nKey="content.block6"
                />
                <ContentBlock
                    text={t.content.block7}
                    i18nKey="content.block7"
                />
                <ContentBlock
                    text={t.content.block8}
                    i18nKey="content.block8"
                />
                <ContentBlock
                    text={t.content.block9}
                    i18nKey="content.block9"
                />
                <ContentBlock
                    text={t.content.block10}
                    highlight={true}
                    i18nKey="content.block10"
                />
            </div>
        </div>
    </section>

    <section
        id="resources"
        class="resources-section"
        aria-label="Все линии подробно"
    >
        <div class="container">
            <div class="resources-head">
                <h2 data-i18n="resources.title">{t.resources.title}</h2>
            </div>

            <div class="helplines-container">
                {
                    allCountries.map((country) => (
                        <HelplineCard
                            countryName={country.name}
                            countryNameEn={(country as any).nameEn}
                            countryNameKk={(country as any).nameKk}
                            lines={country.lines}
                        />
                    ))
                }
            </div>
        </div>
    </section>
</Layout>

<style>
    .grounding-screen {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 0;
    }

    .grounding-content {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .grounding-head {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .grounding-title {
        font-size: var(--font-hero);
        line-height: 1.15;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin: 0;
    }

    .grounding-text {
        font-size: clamp(1.15rem, 3vw, 1.45rem);
        line-height: 1.5;
        color: var(--text-muted);
        margin: 0;
    }

    .all-hotlines-direct {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 2rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .direct-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        font-size: 1.15rem;
    }

    .direct-country {
        color: var(--text-muted);
    }

    .direct-phone {
        color: var(--text-primary);
        font-weight: 500;
        text-decoration: none;
        font-size: 1.25rem;
    }

    .direct-phone:hover {
        color: var(--accent);
        text-decoration: underline;
    }

    .direct-row.detected {
        order: -1;
    }

    .direct-row.detected .direct-country {
        color: var(--text-primary);
        font-weight: 500;
    }

    .direct-row.detected .direct-phone {
        font-size: 1.45rem;
        color: var(--text-primary);
    }

    .content-section {
        padding: 6rem 0;
        border-top: 1px solid var(--border);
    }

    .statements-list {
        display: flex;
        flex-direction: column;
    }

    .resources-section {
        padding: 6rem 0;
        border-top: 1px solid var(--border);
    }

    .resources-head {
        margin-bottom: 2.5rem;
    }

    .resources-head h2 {
        margin: 0;
    }

    .helplines-container {
        display: flex;
        flex-direction: column;
    }
</style>

<script>
    function getCountryFromTimezone(): string | null {
        try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (!tz) return null;
            if (
                tz.includes("Almaty") ||
                tz.includes("Qyzylorda") ||
                tz.includes("Qostanay") ||
                tz.includes("Oral") ||
                tz.includes("Aqtau") ||
                tz.includes("Aqtobe") ||
                tz.includes("Atyrau") ||
                tz.includes("Asia/Almaty")
            )
                return "KZ";
            if (
                tz.includes("Moscow") ||
                tz.includes("Yekaterinburg") ||
                tz.includes("Novosibirsk") ||
                tz.includes("Krasnoyarsk") ||
                tz.includes("Irkutsk") ||
                tz.includes("Vladivostok") ||
                tz.includes("Samara") ||
                tz.includes("Omsk")
            )
                return "RU";
            if (
                tz.includes("Kyiv") ||
                tz.includes("Kiev") ||
                tz.includes("Uzhgorod") ||
                tz.includes("Zaporozhye")
            )
                return "UA";
            if (tz.includes("Minsk")) return "BY";
            if (tz.includes("Bishkek")) return "KG";
            if (tz.includes("Tashkent")) return "UZ";
            if (tz.includes("Tbilisi")) return "GE";
            if (tz.includes("Yerevan")) return "AM";
            if (tz.includes("Chisinau")) return "MD";
            if (tz.includes("Warsaw")) return "PL";
            if (tz.includes("Berlin")) return "DE";
            if (tz.includes("Vilnius")) return "LT";
            if (tz.includes("Riga")) return "LV";
            if (tz.includes("Tallinn")) return "EE";
            if (tz.includes("America/")) return "US";
            if (tz.includes("London") || tz.includes("Europe/London"))
                return "GB";
        } catch {}
        return null;
    }

    function getCountryFromLocale(): string | null {
        const langs = navigator.languages || [navigator.language || ""];
        for (const l of langs) {
            const parts = l.split("-");
            if (parts.length > 1) {
                const region = parts[1].toUpperCase();
                if (region) return region;
            }
        }
        return null;
    }

    async function fetchCountryFromIp(): Promise<string | null> {
        try {
            const res = await fetch("https://ipapi.co/json/", {
                signal: AbortSignal.timeout(1500),
            });
            const data = await res.json();
            if (data.country_code) return data.country_code;
        } catch {}

        try {
            const res = await fetch("https://ipwho.is/", {
                signal: AbortSignal.timeout(1500),
            });
            const data = await res.json();
            if (data.country_code) return data.country_code;
        } catch {}

        return null;
    }

    async function applyDetectedCountry() {
        let country = getCountryFromTimezone() || getCountryFromLocale();

        const updateUI = (code: string) => {
            const row = document.querySelector(
                `.direct-row[data-country-code="${code}"]`,
            );
            if (row) {
                document
                    .querySelectorAll(".direct-row")
                    .forEach((r) => r.classList.remove("detected"));
                row.classList.add("detected");
                const parent = document.getElementById("hotlines-list");
                if (parent) parent.prepend(row);
            }
        };

        if (country) {
            updateUI(country);
        }

        const ipCountry = await fetchCountryFromIp();
        if (ipCountry) {
            updateUI(ipCountry);
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", applyDetectedCountry);
    } else {
        applyDetectedCountry();
    }
</script>
