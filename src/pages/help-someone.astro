---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../i18n/utils';
import helplines from '../data/helplines.json';

const t = getTranslations();
const h = t.helpSomeone;

// Ключевые телефоны доверия (RU, KZ, UA + международный)
const featuredCountries = ['RU', 'KZ', 'UA', 'INT'] as const;
const featuredLines = featuredCountries
  .map(code => (helplines as Record<string, typeof helplines.RU>)[code])
  .filter(Boolean);
---

<Layout
  title={h.meta.title}
  description={h.meta.description}
>
  <!-- Шапка -->
  <header class="page-header">
    <div class="container">
      <a href="/" class="back-link" data-i18n="helpSomeone.hero.back">{h.hero.back}</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero-section section">
    <div class="container">
      <span class="hero-tag" data-i18n="helpSomeone.hero.tag">{h.hero.tag}</span>
      <h1 class="hero-title" data-i18n="helpSomeone.hero.title">{h.hero.title}</h1>
      <p class="hero-subtitle" data-i18n="helpSomeone.hero.subtitle">{h.hero.subtitle}</p>
    </div>
  </section>

  <!-- Признаки -->
  <section class="section signs-section">
    <div class="container">
      <h2 data-i18n="helpSomeone.signs.title">{h.signs.title}</h2>
      <p class="section-intro text-secondary" data-i18n="helpSomeone.signs.intro">{h.signs.intro}</p>

      <ul class="signs-list">
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s1">{h.signs.s1}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s2">{h.signs.s2}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s3">{h.signs.s3}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s4">{h.signs.s4}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s5">{h.signs.s5}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s6">{h.signs.s6}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s7">{h.signs.s7}</li>
        <li class="sign-item fade-in" data-i18n="helpSomeone.signs.s8">{h.signs.s8}</li>
        <li class="sign-item sign-item--accent fade-in" data-i18n="helpSomeone.signs.s9">{h.signs.s9}</li>
      </ul>

      <div class="note-block fade-in">
        <p data-i18n="helpSomeone.signs.note">{h.signs.note}</p>
      </div>
    </div>
  </section>

  <!-- Шаги -->
  <section class="section steps-section">
    <div class="container">
      <h2 data-i18n="helpSomeone.steps.title">{h.steps.title}</h2>

      <div class="steps-grid">
        <div class="step-card card fade-in">
          <div class="step-num">1</div>
          <h3 data-i18n="helpSomeone.steps.s1title">{h.steps.s1title}</h3>
          <p data-i18n="helpSomeone.steps.s1text">{h.steps.s1text}</p>
        </div>
        <div class="step-card card fade-in">
          <div class="step-num">2</div>
          <h3 data-i18n="helpSomeone.steps.s2title">{h.steps.s2title}</h3>
          <p data-i18n="helpSomeone.steps.s2text">{h.steps.s2text}</p>
        </div>
        <div class="step-card card fade-in">
          <div class="step-num">3</div>
          <h3 data-i18n="helpSomeone.steps.s3title">{h.steps.s3title}</h3>
          <p data-i18n="helpSomeone.steps.s3text">{h.steps.s3text}</p>
        </div>
        <div class="step-card card fade-in">
          <div class="step-num">4</div>
          <h3 data-i18n="helpSomeone.steps.s4title">{h.steps.s4title}</h3>
          <p data-i18n="helpSomeone.steps.s4text">{h.steps.s4text}</p>
        </div>
        <div class="step-card card fade-in">
          <div class="step-num">5</div>
          <h3 data-i18n="helpSomeone.steps.s5title">{h.steps.s5title}</h3>
          <p data-i18n="helpSomeone.steps.s5text">{h.steps.s5text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Как говорить -->
  <section class="section talk-section">
    <div class="container">
      <h2 data-i18n="helpSomeone.talk.title">{h.talk.title}</h2>

      <div class="talk-grid">
        <div class="talk-card talk-do card fade-in">
          <h3 class="talk-card-title do-title" data-i18n="helpSomeone.talk.doTitle">{h.talk.doTitle}</h3>
          <ul class="talk-list">
            <li data-i18n="helpSomeone.talk.do1">{h.talk.do1}</li>
            <li data-i18n="helpSomeone.talk.do2">{h.talk.do2}</li>
            <li data-i18n="helpSomeone.talk.do3">{h.talk.do3}</li>
            <li data-i18n="helpSomeone.talk.do4">{h.talk.do4}</li>
            <li data-i18n="helpSomeone.talk.do5">{h.talk.do5}</li>
          </ul>
        </div>

        <div class="talk-card talk-dont card fade-in">
          <h3 class="talk-card-title dont-title" data-i18n="helpSomeone.talk.dontTitle">{h.talk.dontTitle}</h3>
          <ul class="talk-list">
            <li data-i18n="helpSomeone.talk.dont1">{h.talk.dont1}</li>
            <li data-i18n="helpSomeone.talk.dont2">{h.talk.dont2}</li>
            <li data-i18n="helpSomeone.talk.dont3">{h.talk.dont3}</li>
            <li data-i18n="helpSomeone.talk.dont4">{h.talk.dont4}</li>
            <li data-i18n="helpSomeone.talk.dont5">{h.talk.dont5}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Развенчание мифа -->
  <section class="section myth-section">
    <div class="container">
      <div class="myth-block card fade-in">
        <h2 data-i18n="helpSomeone.myth.title">{h.myth.title}</h2>
        <p data-i18n="helpSomeone.myth.text">{h.myth.text}</p>
      </div>
    </div>
  </section>

  <!-- О себе -->
  <section class="section yourself-section">
    <div class="container">
      <h2 data-i18n="helpSomeone.yourself.title">{h.yourself.title}</h2>
      <p class="yourself-text" data-i18n="helpSomeone.yourself.text1">{h.yourself.text1}</p>
      <p class="yourself-text" data-i18n="helpSomeone.yourself.text2">{h.yourself.text2}</p>
      <p class="yourself-text text-accent" data-i18n="helpSomeone.yourself.text3">{h.yourself.text3}</p>
    </div>
  </section>

  <!-- Телефоны -->
  <section class="section hotlines-section">
    <div class="container">
      <h2 data-i18n="helpSomeone.hotlines.title">{h.hotlines.title}</h2>
      <p class="text-secondary mb-xl" data-i18n="helpSomeone.hotlines.text">{h.hotlines.text}</p>

      <div class="hotlines-grid">
        {featuredLines.map(country => (
          <div class="hotline-card card fade-in">
            <div
              class="hotline-country"
              data-name-ru={country.name}
              data-name-en={(country as any).nameEn || country.name}
              data-name-kk={(country as any).nameKk || country.name}
            >{country.name}</div>
            {country.lines.slice(0, 2).map(line => (
              <a href={`tel:${line.phone.replace(/[^\d+]/g, '')}`} class="hotline-phone">
                {line.phone}
              </a>
            ))}
          </div>
        ))}
      </div>

      <div class="hotlines-link-wrap mt-xl">
        <a href="/#resources" class="btn btn-primary" data-i18n="helpSomeone.hotlines.link">
          {h.hotlines.link}
        </a>
      </div>
    </div>
  </section>

  <!-- Футер -->
</Layout>

<style>
  /* Шапка */
  .page-header {
    padding: var(--space-lg) 0 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* Hero */
  .hero-section {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
  }

  .hero-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-lg);
  }

  .hero-title {
    margin-bottom: var(--space-lg);
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 0;
  }

  /* Признаки */
  .signs-section {
    background: var(--color-bg-secondary);
  }

  .section-intro {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xl);
    font-size: 1.0625rem;
  }

  .signs-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .sign-item {
    position: relative;
    padding: var(--space-md) var(--space-lg) var(--space-md) calc(var(--space-lg) + 1.5rem);
    background: rgba(45, 40, 56, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .sign-item::before {
    content: '!';
    position: absolute;
    left: var(--space-lg);
    top: 50%;
    transform: translateY(-50%);
    width: 1.125rem;
    height: 1.125rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.125rem;
    text-align: center;
  }

  .note-block {
    background: var(--color-accent-soft);
    border: 1px solid rgba(255, 160, 122, 0.25);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .note-block p {
    color: var(--color-accent);
    font-weight: 500;
    margin: 0;
  }

  .sign-item--accent {
    border-color: rgba(255, 160, 122, 0.3);
    background: rgba(255, 160, 122, 0.06);
  }

  .sign-item--accent::before {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  /* Шаги */
  .steps-section h2 {
    margin-bottom: var(--space-2xl);
  }

  .steps-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .steps-grid .step-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      max-width: 50%;
      margin: 0 auto;
    }
  }

  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .step-num {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-accent), #ff9b6a);
    color: #1a1625;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .step-card h3 {
    font-size: 1.125rem;
    margin: 0;
  }

  .step-card p {
    color: var(--color-text-secondary);
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  /* Как говорить */
  .talk-section {
    background: var(--color-bg-secondary);
  }

  .talk-section h2 {
    margin-bottom: var(--space-2xl);
  }

  .talk-grid {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .talk-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .talk-card-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }

  .do-title {
    color: var(--color-success);
  }

  .dont-title {
    color: #e07070;
  }

  .talk-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .talk-do .talk-list li {
    padding-left: var(--space-lg);
    position: relative;
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .talk-do .talk-list li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: 700;
  }

  .talk-dont .talk-list li {
    padding-left: var(--space-lg);
    position: relative;
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .talk-dont .talk-list li::before {
    content: '×';
    position: absolute;
    left: 0;
    color: #e07070;
    font-weight: 700;
    font-size: 1.1em;
    line-height: 1.3;
  }

  /* Миф */
  .myth-block {
    border-color: rgba(255, 160, 122, 0.3);
  }

  .myth-block h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: var(--space-lg);
    color: var(--color-accent);
  }

  .myth-block p {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin: 0;
  }

  /* О себе */
  .yourself-section h2 {
    margin-bottom: var(--space-xl);
  }

  .yourself-text {
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--space-lg);
  }

  /* Телефоны */
  .hotlines-section {
    background: var(--color-bg-secondary);
  }

  .hotlines-section h2 {
    margin-bottom: var(--space-md);
  }

  .hotlines-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  .hotline-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .hotline-country {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
  }

  .hotline-phone {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .hotline-phone:hover {
    color: var(--color-accent-hover);
  }

  .hotlines-link-wrap {
    text-align: center;
  }

</style>
