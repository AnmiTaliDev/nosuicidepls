---
import Layout from "../layouts/Layout.astro";
import { getTranslations } from "../i18n/utils";
import helplines from "../data/helplines.json";

const t = getTranslations();
const h = t.helpSomeone;

const featuredCountries = ["RU", "KZ", "UA", "INT"] as const;
const featuredLines = featuredCountries
    .map((code) => (helplines as Record<string, typeof helplines.RU>)[code])
    .filter(Boolean);
---

<Layout title={h.meta.title} description={h.meta.description}>
    <div class="container page-container">
        <header class="page-header">
            <a href="/" class="back-link" data-i18n="helpSomeone.hero.back"
                >{h.hero.back}</a
            >
            <h1 class="page-title" data-i18n="helpSomeone.hero.title">
                {h.hero.title}
            </h1>
            <p class="page-subtitle" data-i18n="helpSomeone.hero.subtitle">
                {h.hero.subtitle}
            </p>
        </header>

        <section class="content-section">
            <h2 data-i18n="helpSomeone.signs.title">{h.signs.title}</h2>
            <p data-i18n="helpSomeone.signs.intro">{h.signs.intro}</p>

            <ul class="signs-list">
                <li data-i18n="helpSomeone.signs.s1">{h.signs.s1}</li>
                <li data-i18n="helpSomeone.signs.s2">{h.signs.s2}</li>
                <li data-i18n="helpSomeone.signs.s3">{h.signs.s3}</li>
                <li data-i18n="helpSomeone.signs.s4">{h.signs.s4}</li>
                <li data-i18n="helpSomeone.signs.s5">{h.signs.s5}</li>
                <li data-i18n="helpSomeone.signs.s6">{h.signs.s6}</li>
                <li data-i18n="helpSomeone.signs.s7">{h.signs.s7}</li>
                <li data-i18n="helpSomeone.signs.s8">{h.signs.s8}</li>
                <li data-i18n="helpSomeone.signs.s9">{h.signs.s9}</li>
            </ul>

            <div class="note-box">
                <p data-i18n="helpSomeone.signs.note">{h.signs.note}</p>
            </div>
        </section>

        <section class="content-section">
            <h2 data-i18n="helpSomeone.steps.title">{h.steps.title}</h2>

            <div class="steps-list">
                <div class="step-item">
                    <div class="step-num">1</div>
                    <div class="step-content">
                        <h3 data-i18n="helpSomeone.steps.s1title">
                            {h.steps.s1title}
                        </h3>
                        <p data-i18n="helpSomeone.steps.s1text">
                            {h.steps.s1text}
                        </p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">2</div>
                    <div class="step-content">
                        <h3 data-i18n="helpSomeone.steps.s2title">
                            {h.steps.s2title}
                        </h3>
                        <p data-i18n="helpSomeone.steps.s2text">
                            {h.steps.s2text}
                        </p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">3</div>
                    <div class="step-content">
                        <h3 data-i18n="helpSomeone.steps.s3title">
                            {h.steps.s3title}
                        </h3>
                        <p data-i18n="helpSomeone.steps.s3text">
                            {h.steps.s3text}
                        </p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">4</div>
                    <div class="step-content">
                        <h3 data-i18n="helpSomeone.steps.s4title">
                            {h.steps.s4title}
                        </h3>
                        <p data-i18n="helpSomeone.steps.s4text">
                            {h.steps.s4text}
                        </p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">5</div>
                    <div class="step-content">
                        <h3 data-i18n="helpSomeone.steps.s5title">
                            {h.steps.s5title}
                        </h3>
                        <p data-i18n="helpSomeone.steps.s5text">
                            {h.steps.s5text}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="content-section">
            <h2 data-i18n="helpSomeone.talk.title">{h.talk.title}</h2>

            <div class="talk-columns">
                <div class="talk-column">
                    <h3 class="do-heading" data-i18n="helpSomeone.talk.doTitle">
                        {h.talk.doTitle}
                    </h3>
                    <ul class="talk-list">
                        <li data-i18n="helpSomeone.talk.do1">{h.talk.do1}</li>
                        <li data-i18n="helpSomeone.talk.do2">{h.talk.do2}</li>
                        <li data-i18n="helpSomeone.talk.do3">{h.talk.do3}</li>
                        <li data-i18n="helpSomeone.talk.do4">{h.talk.do4}</li>
                        <li data-i18n="helpSomeone.talk.do5">{h.talk.do5}</li>
                    </ul>
                </div>

                <div class="talk-column">
                    <h3
                        class="dont-heading"
                        data-i18n="helpSomeone.talk.dontTitle"
                    >
                        {h.talk.dontTitle}
                    </h3>
                    <ul class="talk-list">
                        <li data-i18n="helpSomeone.talk.dont1">
                            {h.talk.dont1}
                        </li>
                        <li data-i18n="helpSomeone.talk.dont2">
                            {h.talk.dont2}
                        </li>
                        <li data-i18n="helpSomeone.talk.dont3">
                            {h.talk.dont3}
                        </li>
                        <li data-i18n="helpSomeone.talk.dont4">
                            {h.talk.dont4}
                        </li>
                        <li data-i18n="helpSomeone.talk.dont5">
                            {h.talk.dont5}
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="content-section">
            <h2 data-i18n="helpSomeone.myth.title">{h.myth.title}</h2>
            <p data-i18n="helpSomeone.myth.text">{h.myth.text}</p>
        </section>

        <section class="content-section">
            <h2 data-i18n="helpSomeone.yourself.title">{h.yourself.title}</h2>
            <p data-i18n="helpSomeone.yourself.text1">{h.yourself.text1}</p>
            <p data-i18n="helpSomeone.yourself.text2">{h.yourself.text2}</p>
            <p class="accent-text" data-i18n="helpSomeone.yourself.text3">
                {h.yourself.text3}
            </p>
        </section>

        <section class="content-section">
            <h2 data-i18n="helpSomeone.hotlines.title">{h.hotlines.title}</h2>
            <p data-i18n="helpSomeone.hotlines.text">{h.hotlines.text}</p>

            <div class="hotlines-simple">
                {
                    featuredLines.map((country) => (
                        <div class="hotline-simple-row">
                            <span
                                data-name-ru={country.name}
                                data-name-en={
                                    (country as any).nameEn || country.name
                                }
                                data-name-kk={
                                    (country as any).nameKk || country.name
                                }
                            >
                                {country.name}:
                            </span>
                            {country.lines.slice(0, 1).map((line) => (
                                <a
                                    href={`tel:${line.phone.replace(/[^\d+]/g, "")}`}
                                    class="phone-link"
                                >
                                    {line.phone}
                                </a>
                            ))}
                        </div>
                    ))
                }
            </div>

            <div class="all-link-wrap">
                <a
                    href="/#resources"
                    class="btn btn-accent"
                    data-i18n="helpSomeone.hotlines.link"
                >
                    {h.hotlines.link}
                </a>
            </div>
        </section>
    </div>
</Layout>

<style>
    .page-container {
        padding: 6rem 1.5rem 8rem;
    }

    .page-header {
        margin-bottom: 3.5rem;
    }

    .back-link {
        display: inline-block;
        font-size: var(--font-micro);
        color: var(--text-muted);
        margin-bottom: 2rem;
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--text-primary);
    }

    .page-title {
        margin-bottom: 1rem;
    }

    .page-subtitle {
        font-size: 1.15rem;
        line-height: 1.5;
        margin: 0;
    }

    .content-section {
        padding: 4rem 0;
        border-top: 1px solid var(--border);
    }

    .content-section h2 {
        margin-bottom: 1.5rem;
    }

    .signs-list {
        list-style: disc;
        padding-left: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2rem;
    }

    .signs-list li {
        color: var(--text-muted);
        line-height: 1.5;
    }

    .note-box {
        padding: 1.5rem 1.75rem;
        background: var(--surface-1);
        border-left: 2px solid var(--text-muted);
    }

    .note-box p {
        color: var(--text-primary);
        margin: 0;
    }

    .steps-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .step-item {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
    }

    .step-num {
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--text-muted);
        min-width: 1.5rem;
    }

    .step-content h3 {
        margin-bottom: 0.35rem;
    }

    .step-content p {
        margin: 0;
    }

    .talk-columns {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    @media (min-width: 600px) {
        .talk-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }
    }

    .do-heading {
        margin-bottom: 1rem;
        font-size: 1.05rem;
    }

    .dont-heading {
        margin-bottom: 1rem;
        font-size: 1.05rem;
    }

    .talk-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .talk-column:first-child .talk-list li::before {
        content: "+ ";
        color: var(--text-muted);
        font-weight: 500;
    }

    .talk-column:last-child .talk-list li::before {
        content: "- ";
        color: var(--text-muted);
        font-weight: 500;
    }

    .talk-list li {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .accent-text {
        color: var(--text-primary);
        font-weight: 500;
    }

    .hotlines-simple {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 1.5rem 0;
    }

    .hotline-simple-row {
        display: flex;
        gap: 0.5rem;
        font-size: 1rem;
    }

    .hotline-simple-row span {
        color: var(--text-muted);
    }

    .phone-link {
        color: var(--text-primary);
        font-weight: 500;
    }

    .all-link-wrap {
        margin-top: 2rem;
    }
</style>
